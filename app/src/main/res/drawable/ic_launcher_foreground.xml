<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Central Glowing Quantum Ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#00F5FF" android:offset="0.0" />
                <item android:color="#C084FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Sine Wave / Fractal Cycle -->
    <path
        android:pathData="M38,62 C44,42 48,42 54,54 C60,66 64,66 70,46"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="54"
                android:endX="70"
                android:endY="54"
                android:type="linear">
                <item android:color="#00F5FF" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="0.5" />
                <item android:color="#00FF88" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Halving Epoch Quadrant Markers -->
    <path
        android:pathData="M54,20 L54,26 M88,54 L82,54 M54,88 L54,82 M20,54 L26,54"
        android:strokeColor="#00F5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Climax Star / Peak Node -->
    <path
        android:pathData="M70,46 A3,3 0 1,1 69.9,46"
        android:fillColor="#00FF88" />
</vector>


